{
  "name": "@fjell/providers",
  "description": "Providers for Fjell",
  "version": "4.5.92",
  "license": "Apache-2.0",
  "keywords": [
    "react-providers",
    "fjell"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "lint": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist",
    "test": "npm run lint && vitest run --coverage",
    "precommit": "npm run clean && npm run lint && npm run build && npm run test",
    "prepublishOnly": "npm run clean && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "docs:test": "cd docs && npm run test"
  },
  "dependencies": {
    "@fjell/cache": "^4.7.67",
    "@fjell/client-api": "^4.4.74",
    "@fjell/core": "^4.4.80",
    "@fjell/logging": "^4.4.73",
    "@fjell/types": "^4.4.10",
    "react-error-boundary": "^6.1.2"
  },
  "peerDependencies": {
    "react": "^19.1.2",
    "react-dom": "^19.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@fjell/common-config": "^1.1.41",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "jsdom": "^27.4.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjellgrunn/providers.git"
  }
}
